# Ключ подписи сессий диспетчера. Пока здесь оставлен короткий пример,
# приложение намеренно не стартует: подпись коротким ключом можно подобрать
# перебором и выпустить сессию от чужого имени. Сгенерировать свой:
# openssl rand -hex 32
AUTH_SECRET=change-me

COOKIE_SECURE=false
PORT=8080
