POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://domryadom:change-me@db:5432/domryadom?sslmode=disable
DISPATCHER_LOGIN=dispatcher
DISPATCHER_PASSWORD=change-me

# Ключ подписи сессий диспетчера. Обязателен и не короче 32 символов: с более
# коротким приложение не стартует, потому что такую подпись можно подобрать
# перебором. Сгенерировать свой: openssl rand -hex 32
AUTH_SECRET=change-me

COOKIE_SECURE=false
PORT=8080
