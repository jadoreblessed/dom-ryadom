POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://domryadom:change-me@db:5432/domryadom?sslmode=disable
DISPATCHER_LOGIN=dispatcher

# DISPATCHER_PASSWORD здесь нет намеренно. Если переменная не задана, при
# первом запуске пароль генерируется случайно и печатается в лог один раз:
# docker compose logs app | grep 'пароль сгенерирован'
# Заглушка вида change-me в файле опаснее её отсутствия — она одинаково
# подходит всем, кто её видел. Задать пароль явно можно, но он перестанет
# действовать при следующем пересоздании базы.
# DISPATCHER_PASSWORD=

# Ключ подписи сессий диспетчера. Пока здесь оставлен короткий пример,
# приложение намеренно не стартует: подпись коротким ключом можно подобрать
# перебором и выпустить сессию от чужого имени. Сгенерировать свой:
# openssl rand -hex 32
AUTH_SECRET=change-me

COOKIE_SECURE=false
PORT=8080

# На alwaysdata задайте свой случайный секрет (5–256 символов A-Z/a-z/0-9/_/-).
# Он включает режим MAX Webhook вместо Long Polling и должен совпадать с
# параметром secret при POST https://platform-api2.max.ru/subscriptions.
# MAX_WEBHOOK_SECRET=
